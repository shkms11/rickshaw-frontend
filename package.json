{
    "name": "rickshaw-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:host": "vite --host",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "msw": "msw init public/ --save",
        "barrel": "barrelsby --delete --directory src",
        "keep": "powershell -Command \"Get-ChildItem src -Directory -Recurse | Where-Object { $_.GetFileSystemInfos().Count -eq 0 } | ForEach-Object { New-Item -ItemType File -Path \\\"$($_.FullName)\\\\.gitkeep\\\" -Force }\"",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@fontsource-variable/geist": "^5.2.9",
        "@reduxjs/toolkit": "^2.12.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "framer-motion": "^12.39.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.16.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-leaflet": "^5.0.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.15.1",
        "recharts": "^3.8.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^24.12.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "barrelsby": "^2.8.1",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "jsdom": "^27.0.1",
        "msw": "^2.14.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.12",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^3.2.4"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
